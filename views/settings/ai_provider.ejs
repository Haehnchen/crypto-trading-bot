<div class="p-4">
    <div class="flex gap-6 max-w-[1100px]">
        <%- include('../components/settings_sidebar', { activeSettingsPage }) %>

        <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-semibold mb-4">AI Provider</h1>

            <div class="max-w-[600px] space-y-4">
                <% if (saved) { %>
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
                        <i class="fas fa-circle-check mr-2"></i> Settings saved successfully!
                    </div>
                <% } %>

                <% if (testResult) { %>
                    <div class="<%= testResult.success ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700' %> border px-4 py-3 rounded">
                        <i class="fas <%= testResult.success ? 'fa-circle-check' : 'fa-circle-exclamation' %> mr-2"></i>
                        <%= testResult.message %>
                        <% if (testResult.modelInfo) { %>
                            <span class="text-xs opacity-75 ml-1">(Model: <%= testResult.modelInfo %>)</span>
                        <% } %>
                    </div>
                <% } %>

                <form action="/settings/ai-provider" method="POST" autocomplete="off">
                    <div class="bg-white rounded shadow p-6">
                        <h2 class="text-sm font-semibold text-gray-800 mb-3 flex items-center gap-2">
                            <i class="fas fa-robot text-purple-500"></i> OpenAI-Compatible API
                        </h2>
                        <p class="text-xs text-gray-500 mb-4">
                            Configure an OpenAI-compatible API endpoint for the AI Strategy Builder.
                            Supports OpenAI, Azure OpenAI, Ollama, LM Studio, and other compatible services.
                        </p>
                        <div class="space-y-4">
                            <div>
                                <label for="ai_base_url" class="block text-sm font-medium text-gray-700 mb-1">Base URL</label>
                                <input type="url" id="ai_base_url" name="ai_base_url"
                                       value="<%= settings.aiProvider.baseUrl || '' %>"
                                       placeholder="https://api.openai.com"
                                       class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
                                       autocomplete="off">
                                <p class="mt-1 text-xs text-gray-400">e.g., https://api.openai.com, http://localhost:11434 (Ollama)</p>
                            </div>
                            <div>
                                <label for="ai_api_token" class="block text-sm font-medium text-gray-700 mb-1">API Token</label>
                                <input type="password" id="ai_api_token" name="ai_api_token"
                                       value="<%= settings.aiProvider.apiToken || '' %>"
                                       placeholder="sk-..."
                                       class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
                                       autocomplete="off">
                                <p class="mt-1 text-xs text-gray-400">Leave empty for local services like Ollama</p>
                            </div>
                            <div>
                                <label for="ai_model" class="block text-sm font-medium text-gray-700 mb-1">Model Name</label>
                                <input type="text" id="ai_model" name="ai_model"
                                       value="<%= settings.aiProvider.model || 'gpt-4' %>"
                                       placeholder="gpt-4"
                                       class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                       autocomplete="off">
                                <p class="mt-1 text-xs text-gray-400">e.g., gpt-4, gpt-3.5-turbo, llama3.1, mistral</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-between mt-4">
                        <button type="button" id="test-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded text-sm cursor-pointer border border-gray-300">
                            <i class="fas fa-plug mr-1"></i> Test Connection
                        </button>
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded text-sm cursor-pointer">
                            <i class="fas fa-save mr-1"></i> Save
                        </button>
                    </div>
                </form>

                <div id="test-result" class="hidden"></div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('test-btn').addEventListener('click', async function() {
    const btn = this;
    const resultDiv = document.getElementById('test-result');
    const baseUrl = document.getElementById('ai_base_url').value;
    const apiToken = document.getElementById('ai_api_token').value;
    const model = document.getElementById('ai_model').value;

    if (!baseUrl) {
        resultDiv.className = 'bg-yellow-50 border border-yellow-200 text-yellow-700 px-4 py-3 rounded mt-4';
        resultDiv.innerHTML = '<i class="fas fa-exclamation-triangle mr-2"></i> Please enter a Base URL';
        resultDiv.classList.remove('hidden');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Testing...';
    resultDiv.className = 'bg-gray-50 border border-gray-200 text-gray-600 px-4 py-3 rounded mt-4';
    resultDiv.innerHTML = '<i class="fas fa-circle-info mr-2"></i> Testing connection...';
    resultDiv.classList.remove('hidden');

    try {
        const response = await fetch('/settings/ai-provider/test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ baseUrl, apiToken, model })
        });
        const result = await response.json();

        if (result.success) {
            resultDiv.className = 'bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mt-4';
            resultDiv.innerHTML = '<i class="fas fa-circle-check mr-2"></i> ' + result.message +
                (result.modelInfo ? '<span class="text-xs opacity-75 ml-1">(Model: ' + result.modelInfo + ')</span>' : '');
        } else {
            resultDiv.className = 'bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mt-4';
            resultDiv.innerHTML = '<i class="fas fa-circle-exclamation mr-2"></i> ' + result.message;
        }
    } catch (e) {
        resultDiv.className = 'bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mt-4';
        resultDiv.innerHTML = '<i class="fas fa-circle-exclamation mr-2"></i> Request failed: ' + e.message;
    }

    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-plug mr-1"></i> Test Connection';
});
</script>
